  "association_measures": [
    {"key": "mi", "name": "MI (Mutual Information)", "formula": "log2( O11 · N / (R1 · C1) )", "source": "Church & Hanks (1990)", "uz": "Kam uchraydigan, lekin kuchli bog'langan juftliklarni yuqori baholaydi; MI ≥ 3 odatda kollokatsiya chegarasi (Hunston 2002)."},
    {"key": "t_score", "name": "t-score", "formula": "(O11 − E11) / √O11", "source": "Church et al. (1991)", "uz": "Yuqori chastotali, ishonchli juftliklarni ajratadi; t ≥ 2 odatda statistik ishonchli."},
    {"key": "log_likelihood", "name": "Log-likelihood (G²)", "formula": "2 · Σ O_ij · ln(O_ij / E_ij)", "source": "Dunning (1993)", "uz": "Kichik korpuslar uchun barqaror; G² ≥ 3.84 → p < 0.05, ≥ 10.83 → p < 0.001."},
    {"key": "logdice", "name": "logDice", "formula": "14 + log2( 2 · O11 / (R1 + C1) )", "source": "Rychlý (2008), Sketch Engine", "uz": "Korpus hajmiga bog'liq emas, maksimumi 14; turli korpuslarni qiyoslashga qulay. Lug'atchilikda standart."}
  ],

  "equivalence_types": [
    {"code": "full", "uz": "To'liq ekvivalent", "en": "Full equivalence", "criteria": "Tayanch ham, kollokator ham lug'aviy mos, struktur tipi saqlanadi (so'z tartibi tipologik farq hisobga olinadi).", "example": "black tea ↔ qora choy; mother tongue ↔ ona tili"},
    {"code": "partial", "uz": "Qisman ekvivalent", "en": "Partial equivalence", "criteria": "Tayanch mos, kollokator boshqa leksema bilan beriladi yoki struktur tipi o'zgaradi (fe'l+ot → ot+yengil fe'l).", "example": "strong tea ↔ achchiq choy; give a lecture ↔ ma'ruza o'qimoq"},
    {"code": "zero", "uz": "Nol ekvivalent (lakuna)", "en": "Zero equivalence / lacuna", "criteria": "Tarjima tilida kollokatsion muqobil yo'q: bir so'z, tavsifiy ifoda yoki madaniy moslashtirish qo'llanadi.", "example": "heavy traffic ↔ tirbandlik; catch a cold ↔ shamollamoq"}
  ],

