# Baza sozlamalari
POSTGRES_DB=tilora_db
POSTGRES_USER=tilora_user
POSTGRES_PASSWORD=tilora_super_secure_password_2026

# Xavfsizlik kaliti (JWT)
SECRET_KEY=change_this_to_a_random_32_character_secret_string

# AI Kalitlari (api.b.ai / DeepSeek)
AI_API_KEY=***REMOVED_AI_KEY***
AI_BASE_URL=https://api.b.ai/v1
AI_MODEL=deepseek-v4-flash-vision-exp
OPENAI_API_KEY=***REMOVED_AI_KEY***
OPENAI_BASE_URL=https://api.b.ai/v1
ANTHROPIC_API_KEY=

# Server sozlamalari

WORKERS=4
LOG_LEVEL=info
