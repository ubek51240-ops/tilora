# ============================================================
# TILORA — Muhit o'zgaruvchilari namunasi
# Nusxalang: cp .env.example .env  — so'ng qiymatlarni to'ldiring.
# .env fayli git'ga qo'shilmaydi.
# ============================================================

# --- Baza (Docker/PostgreSQL uchun; lokal rejimda SQLite avtomatik) ---
POSTGRES_DB=tilora_db
POSTGRES_USER=tilora_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- JWT imzo kaliti: kamida 32 belgi. Yaratish: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_random_48_char_secret

# --- AI (api.b.ai / DeepSeek, OpenAI-mos) — kalitsiz tizim lokal algoritmlar bilan ishlaydi
AI_API_KEY=
AI_BASE_URL=https://api.b.ai/v1
AI_MODEL=deepseek-v4-flash-vision-exp
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Xavfsizlik ---
# CORS: ishlab chiqarishda aniq domen(lar), vergul bilan. Lokal demo uchun "*"
ALLOWED_ORIGINS=https://tilora.uz,https://www.tilora.uz
# Swagger/ReDoc ishlab chiqarishda o'chiriladi
DOCS_ENABLED=false
PASSWORD_MIN_LENGTH=8
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_UPLOAD_MB=25
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
AI_MAX_REQUESTS=60
AI_WINDOW_SECONDS=600

# --- Demo hisoblar paroli (faqat seed.py uchun; ishlab chiqarishda o'zgartiring) ---
SEED_PASSWORD=CHANGE_ME_demo_password1

# --- Server ---
PORT=8010
WORKERS=4
LOG_LEVEL=info
