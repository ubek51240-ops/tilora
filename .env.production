# ============================================================
# TILORA — Ishlab chiqarish (production) muhiti NAMUNASI
# deploy.sh bu faylni .env ga nusxalaydi. BARCHA "CHANGE_ME" qiymatlarni
# haqiqiy maxfiy qiymatlar bilan almashtirmasdan serverni ishga tushirmang.
# Haqiqiy kalitlar hech qachon git'ga qo'shilmaydi (.gitignore: .env.*).
# ============================================================

# Baza sozlamalari
POSTGRES_DB=tilora_db
POSTGRES_USER=tilora_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Xavfsizlik kaliti (JWT) — kamida 32 belgi:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_random_48_char_secret

# AI kalitlari (api.b.ai / DeepSeek) — provayder kabinetidan oling
AI_API_KEY=
AI_BASE_URL=https://api.b.ai/v1
AI_MODEL=deepseek-v4-flash-vision-exp
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Xavfsizlik
ALLOWED_ORIGINS=https://tilora.uz,https://www.tilora.uz
DOCS_ENABLED=false
PASSWORD_MIN_LENGTH=8
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_UPLOAD_MB=25

# Demo hisoblar (seed.py) — ishlab chiqarishda seed ishlatmang yoki kuchli parol bering
SEED_PASSWORD=CHANGE_ME_demo_password1

# Server sozlamalari
WORKERS=4
LOG_LEVEL=info
